# OpenAI (형태소 분석 + WSD)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# 우리말샘(또는 표준국어대사전) Open API 인증키
# 발급: https://opendict.korean.go.kr/ → 오픈 API → 인증키 신청
KRDICT_API_KEY=YOUR_URIMALSAEM_KEY

# 우리말샘 검색/상세 API 베이스 URL
KRDICT_BASE_URL=https://opendict.korean.go.kr/api

# 센스 상세(원어/예문)까지 view API로 조회할지 여부 (true 권장, 호출 수 증가)
FETCH_SENSE_DETAIL=true

# 한 표제어당 가져올 최대 후보 센스 수 (WSD 프롬프트 길이 제어)
MAX_SENSES_PER_WORD=12
